---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkButton, LinkCard } from '@astrojs/starlight/components';
import { articleDateFormatter, getArticles } from '../articles';
import { siteInfo } from '../site';

const frontmatter = {
  title: 'Home',
  description: siteInfo.description,
  template: 'splash',
  giscus: false,
  prev: false,
  next: false,
} as const;

const latestArticles = (await getArticles())
  .slice(0, 4)
  .map((entry) => ({
    href: `/${entry.id}/`,
    title: entry.data.title,
    updatedLabel: `Updated ${articleDateFormatter.format(entry.data.date)}`,
    description: entry.data.description ?? 'Read the latest Guanchen article.',
  }));
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true} lang="en">
  <section class="home-intro is-prelude" data-home-intro>
    <section class="home-opening" aria-label="Guanchen signal field">
      <div class="signal-stage home-opening-stage" aria-hidden="true">
        <svg class="signal-loader" viewBox="0 0 120 120" focusable="false">
          <defs>
            <linearGradient id="signal-loader-gradient" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="rgb(122 201 185)" stop-opacity="0.24" />
              <stop offset="0.62" stop-color="rgb(250 250 250)" stop-opacity="0.66" />
              <stop offset="1" stop-color="rgb(253 213 127)" stop-opacity="0.42" />
            </linearGradient>
          </defs>
          <g transform="rotate(-90 60 60)">
            <circle class="signal-loader-track signal-loader-one" cx="60" cy="60" r="42" pathLength="3" />
            <circle class="signal-loader-track signal-loader-two" cx="60" cy="60" r="42" pathLength="3" />
            <circle class="signal-loader-track signal-loader-three" cx="60" cy="60" r="42" pathLength="3" />
            <circle class="signal-loader-progress signal-loader-one" cx="60" cy="60" r="42" pathLength="3" />
            <circle class="signal-loader-progress signal-loader-two" cx="60" cy="60" r="42" pathLength="3" />
            <circle class="signal-loader-progress signal-loader-three" cx="60" cy="60" r="42" pathLength="3" />
          </g>
        </svg>
        <span class="signal-rune rune-one"></span>
        <span class="signal-rune rune-two"></span>
        <span class="signal-rune rune-three"></span>
        <span class="signal-thread thread-one"></span>
        <span class="signal-thread thread-two"></span>
        <span class="signal-thread thread-three"></span>
        <span class="signal-ring ring-one"></span>
        <span class="signal-ring ring-two"></span>
        <span class="signal-ring ring-three"></span>
        <span class="signal-core"></span>
      </div>
    </section>

    <div class="home-content" data-home-content>
      <h2>Architecture for systems with a wider horizon</h2>
      <p class="intro-copy">
        Guanchen helps teams read platform signals, find direction in change, and build foundations that keep
        moving without losing integrity.
      </p>

    <section class="engagement-panel" aria-label="Guanchen approach">
      <div class="engagement-grid">
        <article>
          <p><strong>Read.</strong> Pressure across teams, interfaces, and runtime behavior.</p>
        </article>
        <article>
          <p><strong>Choose.</strong> Standards, tradeoffs, ownership choices, and next steps.</p>
        </article>
        <article>
          <p><strong>Stabilize.</strong> Foundations that hold as ownership, traffic, and dependencies change.</p>
        </article>
      </div>
    </section>

    <section class="latest-publications" aria-labelledby="articles-heading">
      <p class="articles-kicker">Recently updated</p>
      <h2 id="articles-heading"><a class="articles-heading-link" href="/articles/">Articles</a></h2>
      <p class="articles-summary">The most recently updated Guanchen articles, sorted by date.</p>
      <CardGrid>
        {latestArticles.map((article) => (
          <LinkCard
            href={article.href}
            title={article.title}
            description={`<small class="publication-date">${article.updatedLabel}</small> - ${article.description}`}
          />
        ))}
      </CardGrid>
      <div class="articles-actions">
        <LinkButton href="/articles/#all-articles" variant="secondary" icon="right-arrow">View all articles</LinkButton>
      </div>
    </section>
    </div>

  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">
      {siteInfo.name} is a {siteInfo.business.legalForm} by {siteInfo.author.name}; the name is pronounced{' '}
      <em>"{siteInfo.business.pronunciation}"</em> and nods to {siteInfo.business.nameOrigin}.
    </p>
    <div class="contact-grid">
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">💼</span>
        <a href={siteInfo.author.linkedinUrl} target="_blank" rel="noreferrer">{siteInfo.author.linkedinLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href={siteInfo.author.githubContactUrl} target="_blank" rel="noreferrer">{siteInfo.author.githubLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href={`mailto:${siteInfo.author.email}`}>{siteInfo.author.email}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href={siteInfo.business.kvkUrl} target="_blank" rel="noreferrer">{siteInfo.business.kvkLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>{siteInfo.business.vat}</span>
      </span>
    </div>
  </section>
</StarlightPage>

<noscript>
  <style>
    .home-intro.is-prelude .home-content {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  </style>
</noscript>

<script>
  const intro = document.querySelector('[data-home-intro]');
  const content = document.querySelector('[data-home-content]');

  if (intro instanceof HTMLElement && content instanceof HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const preludeDelay = 2650;
    const nativeScrollCleanupDelay = 1800;
    const isAlreadyScrolled = () => window.scrollY > 12;
    const revealContent = (skipTransition = false) => {
      if (skipTransition) {
        intro.classList.add('skip-prelude-transition');
      }

      intro.classList.remove('is-prelude');

      if (skipTransition) {
        window.requestAnimationFrame(() => intro.classList.remove('skip-prelude-transition'));
      }
    };
    const startAutoScroll = () => {
      intro.classList.add('is-auto-scrolling');
    };
    const stopAutoScroll = () => {
      intro.classList.remove('is-auto-scrolling');
    };

    if (reduceMotion || isAlreadyScrolled()) {
      revealContent(true);
    } else {
      let userDirected = false;
      let cleanupTimer = 0;

      const userEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'];

      const cleanup = () => {
        userEvents.forEach((eventName) => window.removeEventListener(eventName, stopPrelude));
      };

      const stopPrelude = () => {
        userDirected = true;
        window.clearTimeout(cleanupTimer);
        stopAutoScroll();
        revealContent(true);
        cleanup();
      };

      userEvents.forEach((eventName) => window.addEventListener(eventName, stopPrelude, { once: true, passive: true }));

      window.requestAnimationFrame(() => {
        if (isAlreadyScrolled()) stopPrelude();
      });

      window.setTimeout(() => {
        if (userDirected || isAlreadyScrolled()) {
          cleanup();
          revealContent(true);
          return;
        }

        revealContent();
        startAutoScroll();

        const header = document.querySelector('.page > header.header');
    const headerOffset = header instanceof HTMLElement ? header.getBoundingClientRect().bottom : 0;
        const contentGap = 24;
        const startY = window.scrollY;
        const targetY = Math.max(0, startY + content.getBoundingClientRect().top - headerOffset - contentGap);
        const distance = targetY - startY;

        if (distance <= 24) {
          stopAutoScroll();
          cleanup();
          return;
        }

        window.scrollTo({ top: targetY, behavior: 'smooth' });
        cleanupTimer = window.setTimeout(() => {
          stopAutoScroll();
          cleanup();
        }, nativeScrollCleanupDelay);
      }, preludeDelay);
    }
  }
</script>

<style>
  :global(html[data-has-sidebar]) {
    --sl-content-width: 74rem;
    --home-panel-width: 74rem;
  }

  .home-intro {
    width: min(100%, var(--home-panel-width));
    margin-inline: auto;
    text-align: center;
  }

  .home-opening {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100vh - var(--sl-nav-height, 4rem) - 1rem);
    padding-block: clamp(0.25rem, 2vh, 1.25rem) clamp(1.5rem, 5vh, 3rem);
  }

  @supports (height: 100svh) {
    .home-opening {
      min-height: calc(100svh - var(--sl-nav-height, 4rem) - 1rem);
    }
  }

  .home-content {
    width: 100%;
    transition:
      opacity 1200ms ease,
      transform 1200ms ease;
  }

  .home-intro.is-prelude .home-content {
    opacity: 0;
    pointer-events: none;
    transform: translateY(1.25rem);
  }

  .home-intro.skip-prelude-transition .home-content,
  .home-intro.skip-prelude-transition .signal-loader {
    transition: none;
  }

  .home-intro :is(h2, h3) {
    -webkit-background-clip: border-box;
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    background-clip: border-box;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 46rem;
    margin-inline: auto;
  }

  .home-content > h2 {
    max-width: 52rem;
    margin: 0 auto 1rem;
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    color: var(--sl-color-white);
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .signal-stage {
    position: relative;
    z-index: 1;
  }

  .signal-stage {
    grid-column: 1;
    grid-row: 1 / span 3;
    min-height: clamp(18rem, 40vw, 30rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.45rem;
    contain: paint;
    background:
      radial-gradient(circle at center, rgb(255 255 255 / 0.08), transparent 28%),
      repeating-radial-gradient(circle at center, transparent 0 2.35rem, rgb(255 255 255 / 0.055) 2.4rem 2.45rem),
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 42%);
    box-shadow: inset 0 0 48px rgb(0 0 0 / 0.45);
  }

  .home-opening .signal-stage {
    grid-column: auto;
    grid-row: auto;
    width: min(100%, 70rem);
    min-height: clamp(18rem, calc(100vh - var(--sl-nav-height, 4rem) - 6rem), 38rem);
  }

  @supports (height: 100svh) {
    .home-opening .signal-stage {
      min-height: clamp(18rem, calc(100svh - var(--sl-nav-height, 4rem) - 6rem), 38rem);
    }
  }

  .signal-stage::before,
  .signal-stage::after {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(255 255 255 / 0.22);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    opacity: 0.42;
    animation: signalTurn 18s linear infinite;
    will-change: transform;
  }

  .signal-stage::after {
    inset: 20%;
    border-color: rgb(122 201 185 / 0.48);
    opacity: 0.54;
    animation-duration: 24s;
    animation-direction: reverse;
  }

  .signal-rune,
  .signal-thread,
  .signal-ring,
  .signal-loader,
  .signal-core {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .signal-loader {
    top: 50%;
    left: 50%;
    width: clamp(10rem, 25vw, 19rem);
    aspect-ratio: 1;
    opacity: 0.18;
    overflow: visible;
    translate: -50% -50%;
    transition: opacity 320ms ease;
  }

  .home-intro.is-prelude .signal-loader {
    opacity: 0.62;
  }

  .signal-loader-track,
  .signal-loader-progress {
    fill: none;
    stroke-linecap: butt;
    stroke-dasharray: 1 2;
    stroke-dashoffset: var(--signal-loader-offset);
    vector-effect: non-scaling-stroke;
  }

  .signal-loader-one {
    --signal-loader-offset: 0;
  }

  .signal-loader-two {
    --signal-loader-offset: -1;
  }

  .signal-loader-three {
    --signal-loader-offset: -2;
  }

  .signal-loader-track {
    stroke: rgb(250 250 250 / 0.13);
    stroke-width: 0.7;
  }

  .signal-loader-progress {
    stroke: url(#signal-loader-gradient);
    stroke-width: 1.1;
  }

  .home-intro.is-prelude .signal-loader-progress {
    animation: signalLoaderFill 1450ms cubic-bezier(0.64, 0, 0.18, 1) 1180ms both;
  }

  .home-intro.is-auto-scrolling .signal-stage::before,
  .home-intro.is-auto-scrolling .signal-stage::after,
  .home-intro.is-auto-scrolling .signal-rune,
  .home-intro.is-auto-scrolling .signal-thread,
  .home-intro.is-auto-scrolling .signal-ring,
  .home-intro.is-auto-scrolling .signal-core {
    animation-play-state: paused;
  }

  .signal-rune {
    width: clamp(3rem, 7vw, 5.6rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.26);
    transform: rotate(45deg);
    animation: runeDrift 8s ease-in-out infinite alternate;
    will-change: transform;
  }

  .signal-rune::before,
  .signal-rune::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid currentColor;
    color: rgb(255 255 255 / 0.26);
  }

  .signal-rune::after {
    inset: 42% -28%;
    border-inline: 0;
  }

  .rune-one {
    top: 14%;
    left: 16%;
    color: rgb(122 201 185 / 0.78);
  }

  .rune-two {
    right: 14%;
    bottom: 18%;
    color: rgb(253 213 127 / 0.68);
    animation-delay: -2s;
  }

  .rune-three {
    top: 53%;
    left: 44%;
    width: clamp(2rem, 5vw, 4rem);
    color: rgb(231 238 224 / 0.55);
    animation-delay: -4s;
  }

  .signal-thread {
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(122 201 185 / 0.72), rgb(253 213 127 / 0.72), transparent);
    transform-origin: 50% 50%;
    animation: threadPulse 7s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .thread-one {
    top: 33%;
    transform: rotate(11deg);
  }

  .thread-two {
    top: 58%;
    transform: rotate(-17deg);
    animation-delay: -2.4s;
  }

  .thread-three {
    top: 74%;
    transform: rotate(4deg);
    animation-delay: -4.6s;
  }

  .signal-ring {
    inset: 50% auto auto 50%;
    width: clamp(8rem, 22vw, 18rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 50%;
    translate: -50% -50%;
    animation: ringBreathe 9s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .ring-two {
    width: clamp(12rem, 30vw, 24rem);
    border-style: dashed;
    border-color: rgb(122 201 185 / 0.34);
    animation-delay: -3s;
  }

  .ring-three {
    width: clamp(16rem, 38vw, 31rem);
    border-color: rgb(253 213 127 / 0.22);
    animation-delay: -6s;
  }

  .signal-core {
    top: 50%;
    left: 50%;
    width: clamp(4.5rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.72) 0 2px, transparent 3px),
      conic-gradient(from 0deg, rgb(122 201 185 / 0.08), rgb(253 213 127 / 0.28), rgb(255 255 255 / 0.08), rgb(122 201 185 / 0.08));
    box-shadow:
      0 0 38px rgb(122 201 185 / 0.28),
      inset 0 0 24px rgb(255 255 255 / 0.12);
    translate: -50% -50%;
    animation: coreTurn 10s linear infinite;
    will-change: transform;
  }

  .signal-core::before,
  .signal-core::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid rgb(255 255 255 / 0.34);
    transform: rotate(45deg);
  }

  .signal-core::after {
    inset: 36%;
    border-radius: 50%;
    transform: none;
  }

  @keyframes signalTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes runeDrift {
    from {
      translate: -0.35rem 0.25rem;
    }

    to {
      translate: 0.35rem -0.25rem;
    }
  }

  @keyframes threadPulse {
    0%,
    100% {
      opacity: 0.22;
      scale: 0.86 1;
    }

    50% {
      opacity: 0.88;
      scale: 1 1;
    }
  }

  @keyframes ringBreathe {
    0%,
    100% {
      opacity: 0.28;
      scale: 0.96;
    }

    50% {
      opacity: 0.68;
      scale: 1.04;
    }
  }

  @keyframes coreTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes signalLoaderFill {
    from {
      stroke-dasharray: 0 3;
    }

    to {
      stroke-dasharray: 1 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro.is-prelude .signal-loader-progress,
    .signal-stage::before,
    .signal-stage::after,
    .signal-rune,
    .signal-thread,
    .signal-ring,
    .signal-core {
      animation: none;
    }
  }

  .engagement-panel {
    width: min(100%, 62rem);
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    padding-block-start: clamp(1rem, 3vw, 1.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    text-align: left;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .engagement-grid article {
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .engagement-grid strong {
    color: rgb(250 250 250 / 0.9);
    font-weight: 650;
    -webkit-text-fill-color: currentColor;
  }

  .engagement-grid p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .latest-publications {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 18% 18%, rgb(122 201 185 / 0.26), transparent 42%),
      radial-gradient(ellipse at 88% 84%, rgb(253 213 127 / 0.18), transparent 38%),
      linear-gradient(180deg, rgb(6 7 10 / 0.58), rgb(6 7 10 / 0.76)),
      url('/assets/analog-article-collage.svg') center / cover no-repeat;
    box-shadow:
      0 18px 54px rgb(0 0 0 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    text-align: center;
  }

  .latest-publications h2 {
    margin: 0.35rem auto 0;
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    line-height: 1.05;
    text-align: center;
  }

  .articles-kicker,
  .articles-summary {
    margin: 0;
    text-align: center;
  }

  .articles-kicker {
    color: rgb(253 213 127 / 0.86);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .articles-summary {
    max-width: 34rem;
    margin: 0.7rem auto 1rem;
    color: rgb(250 250 250 / 0.76);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .articles-heading-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    -webkit-text-fill-color: inherit;
  }

  .articles-heading-link:hover,
  .articles-heading-link:focus-visible {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .latest-publications :global(.card-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    text-align: center;
  }

  .latest-publications :global(.sl-link-card) {
    min-height: 100%;
    border-color: rgb(255 255 255 / 0.16);
    background: rgb(9 9 11 / 0.72);
    text-align: center;
  }

  .latest-publications :global(.sl-link-card .stack) {
    align-items: center;
  }

  .latest-publications :global(.sl-link-card .description) {
    overflow-wrap: anywhere;
  }

  .articles-actions {
    display: flex;
    justify-content: center;
    margin-block-start: 1rem;
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contact-strip .eyebrow {
    max-width: 36rem;
  }

  .contact-strip {
    width: min(100%, 46rem);
    margin-inline: auto;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 46rem) {
    .contact-strip {
      margin-block-end: 4rem;
    }

    .intro-copy,
    .latest-publications {
      width: 100%;
    }

    .home-intro > h2 {
      font-size: 2.35rem;
    }

    .signal-stage {
      grid-column: 1;
      grid-row: 1;
      min-height: clamp(16rem, 78vw, 24rem);
    }

    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .engagement-grid article {
      min-height: auto;
