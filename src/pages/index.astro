---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, LinkButton, LinkCard } from '@astrojs/starlight/components';
import { articleNavItems } from '../article-nav.mjs';

type ArticleEntry = {
  id: string;
  data: {
    title: string;
    description?: string;
    date?: Date;
  };
};

const frontmatter = {
  title: 'Home',
  description:
    'Guanchen - technology consulting for resilient systems across cloud, APIs, integration, observability, and operations.',
  template: 'splash',
  giscus: false,
  prev: false,
  next: false,
} as const;

const articleRank = new Map(
  articleNavItems.map((item, index) => [item.link.replace(/^\//, '').replace(/\/$/, ''), index]),
);
const updateDateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const latestArticles = ((await getCollection('docs')) as ArticleEntry[])
  .filter((entry) => entry.id.startsWith('articles/') && entry.data.date)
  .sort((a, b) => {
    const dateDifference = (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);

    if (dateDifference !== 0) return dateDifference;

    return (articleRank.get(a.id) ?? Number.MAX_SAFE_INTEGER) - (articleRank.get(b.id) ?? Number.MAX_SAFE_INTEGER);
  })
  .slice(0, 3)
  .map((entry) => ({
    href: `/${entry.id}/`,
    title: entry.data.title,
    updatedLabel: `Updated ${updateDateFormatter.format(entry.data.date)}`,
    description: entry.data.description ?? 'Read the latest Guanchen article.',
  }));
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true} lang="en">
  <section class="home-intro">
    <h2>Adaptive systems consulting</h2>
    <p class="intro-copy">
      Guanchen helps organizations build foundations that evolve without losing integrity. Architecture
      is not more machinery; it is clearer agreement between people, software, and uncertainty.
    </p>

    <section class="signal-cards" aria-label="Systems work for uncertain terrain">
      <Card title="A moving map for the hidden forces in your platform">
        <div class="signal-stage" aria-hidden="true">
          <span class="signal-rune rune-one"></span>
          <span class="signal-rune rune-two"></span>
          <span class="signal-rune rune-three"></span>
          <span class="signal-thread thread-one"></span>
          <span class="signal-thread thread-two"></span>
          <span class="signal-thread thread-three"></span>
          <span class="signal-ring ring-one"></span>
          <span class="signal-ring ring-two"></span>
          <span class="signal-ring ring-three"></span>
          <span class="signal-core"></span>
        </div>
        <p class="signal-eyebrow">Systems work for uncertain terrain</p>
        <p class="signal-description">
          APIs, queues, cloud foundations, observability, and operations all leave traces. Guanchen turns
          those traces into decisions teams can trust, then helps make the next change smaller.
        </p>
      </Card>
    </section>

    <section class="engagement-panel" aria-labelledby="engagement-heading">
      <p class="eyebrow">Engagements are intentionally practical</p>
      <h2 id="engagement-heading">From uneasy signals to reliable movement</h2>
      <div class="engagement-grid">
        <article>
          <h3>Clarify the shape</h3>
          <p>Map the current pressure across teams, interfaces, runtime behavior, and delivery flow.</p>
        </article>
        <article>
          <h3>Reduce the drag</h3>
          <p>Turn noisy architecture debates into a smaller set of standards, tradeoffs, and next steps.</p>
        </article>
        <article>
          <h3>Strengthen the system</h3>
          <p>Design foundations that hold up when ownership, traffic, dependencies, and incidents change.</p>
        </article>
      </div>
    </section>

    <section class="latest-publications" aria-labelledby="articles-heading">
      <p class="articles-kicker">Recently updated</p>
      <h2 id="articles-heading"><a class="articles-heading-link" href="/articles/">Articles</a></h2>
      <p class="articles-summary">The three newest Guanchen articles, ordered by update date.</p>
      <CardGrid>
        {latestArticles.map((article) => (
          <LinkCard
            href={article.href}
            title={article.title}
            description={`<small class="publication-date">${article.updatedLabel}</small> - ${article.description}`}
          />
        ))}
      </CardGrid>
      <div class="articles-actions">
        <LinkButton href="/articles/" variant="secondary" icon="right-arrow">View all articles</LinkButton>
      </div>
    </section>

  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">
      Guanchen is a sole proprietorship by Erwin Kramer; the name is pronounced <em>"GWAN-chay"</em> and nods to the Guanches, pre-Hispanic island people of the Canaries.
    </p>
    <div class="contact-grid">
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">💼</span>
        <a href="https://www.linkedin.com/in/kramererwin/" target="_blank" rel="noreferrer">linkedin/kramererwin</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href="https://github.com/erwinkramer#-hi-there" target="_blank" rel="noreferrer">github/erwinkramer</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href="mailto:info@guanchen.nl">info@guanchen.nl</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href="https://www.kvk.nl/bestellen/#/88833801000054661021/" target="_blank" rel="noreferrer">KvK 88833801</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>VAT NL003007917B65</span>
      </span>
    </div>
  </section>
</StarlightPage>

<script>
  const resizeRoot = document.documentElement;
  let resizeTimer = 0;

  window.addEventListener(
    'resize',
    () => {
      resizeRoot.setAttribute('data-resizing', '');
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resizeRoot.removeAttribute('data-resizing');
      }, 180);
    },
    { passive: true },
  );
</script>

<style>
  :global(html[data-has-sidebar]) {
    --sl-content-width: 74rem;
    --home-panel-width: 74rem;
  }

  .home-intro {
    width: min(100%, var(--home-panel-width));
    margin-inline: auto;
    text-align: center;
  }

  .home-intro :is(h2, h3) {
    -webkit-background-clip: border-box;
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    background-clip: border-box;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 46rem;
    margin-inline: auto;
  }

  .signal-cards {
    width: 100%;
    margin: clamp(1.75rem, 5vw, 3.5rem) auto 0;
    text-align: left;
  }

  .signal-cards :global(.card) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(17rem, 0.82fr);
    gap: clamp(1.25rem, 4vw, 3.75rem);
    align-items: center;
    min-width: 0;
    width: 100%;
    padding: clamp(1rem, 3vw, 1.6rem);
    contain: layout paint style;
    isolation: isolate;
    overflow: hidden;
    border-color: rgb(255 255 255 / 0.18);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 18% 22%, rgb(122 201 185 / 0.22), transparent 42%),
      radial-gradient(ellipse at 84% 16%, rgb(253 213 127 / 0.18), transparent 34%),
      linear-gradient(135deg, rgb(19 23 25 / 0.92), rgb(7 8 10 / 0.9) 58%, rgb(17 18 15 / 0.9));
    box-shadow:
      0 26px 70px rgb(0 0 0 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  .signal-cards :global(.card)::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(0deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 3.75rem 3.75rem;
    mask-image: radial-gradient(ellipse at 36% 52%, black 18%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse at 36% 52%, black 18%, transparent 72%);
    pointer-events: none;
    transform: translateZ(0);
  }

  .signal-cards :global(.card)::after {
    content: '';
    position: absolute;
    inset: -35% -10%;
    background: conic-gradient(from 90deg, transparent, rgb(255 255 255 / 0.12), transparent 24%, transparent 100%);
    opacity: 0.48;
    animation: signalSweep 12s linear infinite;
    pointer-events: none;
    transform: translateZ(0);
    will-change: transform;
  }

  .signal-cards :global(.title) {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 2;
    align-items: flex-start;
    margin-block: 0 0.85rem;
    -webkit-background-clip: border-box;
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    background-clip: border-box;
    color: var(--sl-color-white);
    font-size: clamp(1.55rem, 3.2vw, 2.9rem);
    line-height: 1.08;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .signal-cards :global(.body) {
    display: contents;
  }

  .signal-stage,
  .signal-eyebrow,
  .signal-description {
    position: relative;
    z-index: 1;
  }

  .signal-stage {
    grid-column: 1;
    grid-row: 1 / span 3;
    min-height: clamp(18rem, 40vw, 30rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.45rem;
    contain: paint;
    background:
      radial-gradient(circle at center, rgb(255 255 255 / 0.08), transparent 28%),
      repeating-radial-gradient(circle at center, transparent 0 2.35rem, rgb(255 255 255 / 0.055) 2.4rem 2.45rem),
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 42%);
    box-shadow: inset 0 0 48px rgb(0 0 0 / 0.45);
  }

  .signal-stage::before,
  .signal-stage::after {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(255 255 255 / 0.22);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    opacity: 0.42;
    animation: signalTurn 18s linear infinite;
    will-change: transform;
  }

  .signal-stage::after {
    inset: 20%;
    border-color: rgb(122 201 185 / 0.48);
    opacity: 0.54;
    animation-duration: 24s;
    animation-direction: reverse;
  }

  .signal-rune,
  .signal-thread,
  .signal-ring,
  .signal-core {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .signal-rune {
    width: clamp(3rem, 7vw, 5.6rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.26);
    transform: rotate(45deg);
    animation: runeDrift 8s ease-in-out infinite alternate;
    will-change: transform;
  }

  .signal-rune::before,
  .signal-rune::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid currentColor;
    color: rgb(255 255 255 / 0.26);
  }

  .signal-rune::after {
    inset: 42% -28%;
    border-inline: 0;
  }

  .rune-one {
    top: 14%;
    left: 16%;
    color: rgb(122 201 185 / 0.78);
  }

  .rune-two {
    right: 14%;
    bottom: 18%;
    color: rgb(253 213 127 / 0.68);
    animation-delay: -2s;
  }

  .rune-three {
    top: 53%;
    left: 44%;
    width: clamp(2rem, 5vw, 4rem);
    color: rgb(231 238 224 / 0.55);
    animation-delay: -4s;
  }

  .signal-thread {
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(122 201 185 / 0.72), rgb(253 213 127 / 0.72), transparent);
    transform-origin: 50% 50%;
    animation: threadPulse 7s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .thread-one {
    top: 33%;
    transform: rotate(11deg);
  }

  .thread-two {
    top: 58%;
    transform: rotate(-17deg);
    animation-delay: -2.4s;
  }

  .thread-three {
    top: 74%;
    transform: rotate(4deg);
    animation-delay: -4.6s;
  }

  .signal-ring {
    inset: 50% auto auto 50%;
    width: clamp(8rem, 22vw, 18rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 50%;
    translate: -50% -50%;
    animation: ringBreathe 9s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .ring-two {
    width: clamp(12rem, 30vw, 24rem);
    border-style: dashed;
    border-color: rgb(122 201 185 / 0.34);
    animation-delay: -3s;
  }

  .ring-three {
    width: clamp(16rem, 38vw, 31rem);
    border-color: rgb(253 213 127 / 0.22);
    animation-delay: -6s;
  }

  .signal-core {
    top: 50%;
    left: 50%;
    width: clamp(4.5rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.72) 0 2px, transparent 3px),
      conic-gradient(from 0deg, rgb(122 201 185 / 0.08), rgb(253 213 127 / 0.28), rgb(255 255 255 / 0.08), rgb(122 201 185 / 0.08));
    box-shadow:
      0 0 38px rgb(122 201 185 / 0.28),
      inset 0 0 24px rgb(255 255 255 / 0.12);
    translate: -50% -50%;
    animation: coreTurn 10s linear infinite;
    will-change: transform;
  }

  .signal-core::before,
  .signal-core::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid rgb(255 255 255 / 0.34);
    transform: rotate(45deg);
  }

  .signal-core::after {
    inset: 36%;
    border-radius: 50%;
    transform: none;
  }

  .signal-eyebrow {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    margin: 0 0 0.65rem;
    color: rgb(253 213 127 / 0.78);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .signal-description {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
    margin: 0;
    color: rgb(250 250 250 / 0.78);
    font-size: var(--sl-text-base);
    line-height: 1.55;
  }

  @keyframes signalSweep {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes signalTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes runeDrift {
    from {
      translate: -0.35rem 0.25rem;
    }

    to {
      translate: 0.35rem -0.25rem;
    }
  }

  @keyframes threadPulse {
    0%,
    100% {
      opacity: 0.22;
      scale: 0.86 1;
    }

    50% {
      opacity: 0.88;
      scale: 1 1;
    }
  }

  @keyframes ringBreathe {
    0%,
    100% {
      opacity: 0.28;
      scale: 0.96;
    }

    50% {
      opacity: 0.68;
      scale: 1.04;
    }
  }

  @keyframes coreTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-cards :global(.card)::after,
    .signal-stage::before,
    .signal-stage::after,
    .signal-rune,
    .signal-thread,
    .signal-ring,
    .signal-core {
      animation: none;
    }
  }

  :global(html[data-resizing]) .signal-cards :global(.card)::after,
  :global(html[data-resizing]) .signal-stage::before,
  :global(html[data-resizing]) .signal-stage::after,
  :global(html[data-resizing]) .signal-rune,
  :global(html[data-resizing]) .signal-thread,
  :global(html[data-resizing]) .signal-ring,
  :global(html[data-resizing]) .signal-core {
    animation-play-state: paused;
  }

  :global(html[data-resizing] body::after) {
    opacity: 0.03;
  }

  .engagement-panel {
    width: 100%;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    text-align: left;
  }

  .engagement-panel > .eyebrow {
    margin-block-end: 0.35rem;
    color: var(--sl-color-gray-2);
    text-align: center;
  }

  .engagement-panel > h2 {
    max-width: 39rem;
    margin: 0 auto 1rem;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    text-align: center;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .engagement-grid article {
    min-height: 10.5rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 0.5rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.025));
  }

  .engagement-grid h3 {
    margin-block: 0 0.45rem;
    font-size: var(--sl-text-lg);
  }

  .engagement-grid p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .latest-publications {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 18% 18%, rgb(122 201 185 / 0.26), transparent 42%),
      radial-gradient(ellipse at 88% 84%, rgb(253 213 127 / 0.18), transparent 38%),
      linear-gradient(180deg, rgb(6 7 10 / 0.58), rgb(6 7 10 / 0.76)),
      url('/assets/analog-article-collage.svg') center / cover no-repeat;
    box-shadow:
      0 18px 54px rgb(0 0 0 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    text-align: center;
  }

  .latest-publications h2 {
    margin: 0.35rem auto 0;
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    line-height: 1.05;
    text-align: center;
  }

  .articles-kicker,
  .articles-summary {
    margin: 0;
    text-align: center;
  }

  .articles-kicker {
    color: rgb(253 213 127 / 0.86);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .articles-summary {
    max-width: 34rem;
    margin: 0.7rem auto 1rem;
    color: rgb(250 250 250 / 0.76);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .articles-heading-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    -webkit-text-fill-color: inherit;
  }

  .articles-heading-link:hover,
  .articles-heading-link:focus-visible {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .latest-publications :global(.card-grid) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    text-align: center;
  }

  .latest-publications :global(.sl-link-card) {
    min-height: 100%;
    border-color: rgb(255 255 255 / 0.16);
    background: rgb(9 9 11 / 0.72);
    text-align: center;
  }

  .latest-publications :global(.sl-link-card .stack) {
    align-items: center;
  }

  .latest-publications :global(.sl-link-card .description) {
    overflow-wrap: anywhere;
  }

  .latest-publications :global(.publication-date) {
    color: rgb(250 250 250 / 0.68);
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .articles-actions {
    display: flex;
    justify-content: center;
    margin-block-start: 1rem;
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contact-strip .eyebrow {
    max-width: 36rem;
  }

  .contact-strip {
    width: min(100%, 46rem);
    margin-inline: auto;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 46rem) {
    .contact-strip {
      margin-block-end: 4rem;
    }

    .intro-copy,
    .signal-cards,
    .latest-publications {
      width: 100%;
    }

    .signal-cards :global(.card) {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 0.75rem;
    }

    .signal-stage {
      grid-column: 1;
      grid-row: 1;
      min-height: clamp(16rem, 78vw, 24rem);
    }

    .signal-eyebrow {
      grid-column: 1;
      grid-row: 2;
      align-self: auto;
      margin: 0;
      text-align: center;
    }

    .signal-cards :global(.title) {
      grid-column: 1;
      grid-row: 3;
      margin-block: 0;
      font-size: clamp(1.45rem, 8vw, 2.15rem);
      text-align: center;
    }

    .signal-description {
      grid-column: 1;
      grid-row: 4;
      text-align: center;
    }

    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .engagement-grid article {
      min-height: auto;
    }

    .latest-publications {
      padding: 0.875rem;
    }

    .articles-kicker {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }

    .articles-summary {
      max-width: 18rem;
      font-size: 0.76rem;
      line-height: 1.35;
    }

    .latest-publications :global(.card-grid) {
