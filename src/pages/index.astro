---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkButton, LinkCard } from '@astrojs/starlight/components';
import { articleDateFormatter, getArticles } from '../articles';
import { siteInfo } from '../site';

const frontmatter = {
  title: 'Home',
  description: siteInfo.description,
  template: 'splash',
  giscus: false,
  prev: false,
  next: false,
} as const;

const latestArticles = (await getArticles())
  .slice(0, 4)
  .map((entry) => ({
    href: `/${entry.id}/`,
    title: entry.data.title,
    updatedLabel: `Updated ${articleDateFormatter.format(entry.data.date)}`,
    description: entry.data.description ?? 'Read the latest Guanchen article.',
  }));
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true} lang="en">
  <section class="home-intro" data-home-intro>
    <section class="home-opening" aria-label="Guanchen signal field">
      <div class="home-hero-copy">
        <h1>Architecture for systems with a wider horizon</h1>
        <p class="intro-copy">
          Guanchen helps teams read platform signals, find direction in change, and build foundations that keep
          moving without losing integrity.
        </p>
        <div class="hero-actions">
          <LinkButton href="/articles/" variant="primary" icon="right-arrow">Read the articles</LinkButton>
          <LinkButton href={`mailto:${siteInfo.author.email}`} variant="secondary">Get in touch</LinkButton>
        </div>
      </div>
      <div class="signal-stage home-opening-stage" aria-hidden="true">
        <span class="signal-starfield"></span>
        <span class="signal-starfield-near"></span>
        <span class="signal-thread thread-one"></span>
        <span class="signal-thread thread-two"></span>
        <span class="signal-thread thread-three"></span>
        <span class="signal-ring ring-one"></span>
        <span class="signal-ring ring-two"></span>
        <span class="signal-ring ring-three"></span>
        <span class="signal-core"></span>
      </div>
    </section>

    <div class="home-content" data-home-content>
    <section class="engagement-panel" aria-label="Guanchen approach">
      <div class="engagement-grid">
        <article>
          <p><strong>Read.</strong> Pressure across teams, interfaces, and runtime behavior.</p>
        </article>
        <article>
          <p><strong>Choose.</strong> Standards, tradeoffs, ownership choices, and next steps.</p>
        </article>
        <article>
          <p><strong>Stabilize.</strong> Foundations that hold as ownership, traffic, and dependencies change.</p>
        </article>
      </div>
    </section>

    <section class="latest-publications" aria-labelledby="articles-heading">
      <p class="articles-kicker">Recently updated</p>
      <h2 id="articles-heading"><a class="articles-heading-link" href="/articles/">Articles</a></h2>
      <p class="articles-summary">The most recently updated Guanchen articles, sorted by date.</p>
      <CardGrid>
        {latestArticles.map((article) => (
          <LinkCard
            href={article.href}
            title={article.title}
            description={`<small class="publication-date">${article.updatedLabel}</small> - ${article.description}`}
          />
        ))}
      </CardGrid>
      <div class="articles-actions">
        <LinkButton href="/articles/#all-articles" variant="secondary" icon="right-arrow">View all articles</LinkButton>
      </div>
    </section>
    </div>

  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">
      {siteInfo.name} is a {siteInfo.business.legalForm} by {siteInfo.author.name}; the name is pronounced{' '}
      <em>"{siteInfo.business.pronunciation}"</em> and nods to {siteInfo.business.nameOrigin}.
    </p>
    <div class="contact-grid">
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">💼</span>
        <a href={siteInfo.author.linkedinUrl} target="_blank" rel="noreferrer">{siteInfo.author.linkedinLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href={siteInfo.author.githubContactUrl} target="_blank" rel="noreferrer">{siteInfo.author.githubLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href={`mailto:${siteInfo.author.email}`}>{siteInfo.author.email}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href={siteInfo.business.kvkUrl} target="_blank" rel="noreferrer">{siteInfo.business.kvkLabel}</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>{siteInfo.business.vat}</span>
      </span>
    </div>
  </section>
</StarlightPage>

<script>
  const stage = document.querySelector('.home-opening-stage');

  if (stage instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    let lastValue = '';

    const updateParallax = () => {
      const t = Math.min(window.scrollY, 600) / 600;
      const value = `${(t * 120).toFixed(2)}px`;
      if (value !== lastValue) {
        stage.style.setProperty('--signal-parallax', value);
        lastValue = value;
      }
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    updateParallax();
  }
</script>

<style>
  :global(html[data-has-sidebar]) {
    --sl-content-width: 74rem;
    --home-panel-width: 74rem;
  }

  .home-intro {
    width: min(100%, var(--home-panel-width));
    margin-inline: auto;
  }

  .home-opening {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    min-height: calc(100vh - var(--sl-nav-height, 4rem) - 1rem);
    padding-block: clamp(1rem, 4vh, 2.5rem);
  }

  @supports (height: 100svh) {
    .home-opening {
      min-height: calc(100svh - var(--sl-nav-height, 4rem) - 1rem);
    }
  }

  .home-hero-copy {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    text-align: left;
  }

  .home-hero-copy h1 {
    margin: 0;
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    color: var(--sl-color-white);
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .intro-copy {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .signal-stage {
    --signal-thread-gap: clamp(3.75rem, 16%, 6.5rem);
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.75rem;
    contain: paint;
    background:
      /* Nebula washes */
      radial-gradient(ellipse at 20% 76%, rgb(122 201 185 / 0.18), transparent 52%),
      radial-gradient(ellipse at 82% 18%, rgb(253 213 127 / 0.13), transparent 44%),
      radial-gradient(ellipse at 58% 50%, rgb(130 110 210 / 0.08), transparent 40%),
      /* Central luminance */
      radial-gradient(circle at center, rgb(255 255 255 / 0.12), transparent 32%),
      /* Denser concentric rings */
      repeating-radial-gradient(circle at center, transparent 0 1.55rem, rgb(255 255 255 / 0.046) 1.6rem 1.64rem),
      linear-gradient(180deg, rgb(255 255 255 / 0.048), transparent 48%);
    box-shadow: inset 0 0 52px rgb(0 0 0 / 0.30);
  }

  .home-opening .signal-stage {
    width: 100%;
    height: clamp(20rem, 50vh, 32rem);
  }

  .signal-stage::before,
  .signal-stage::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(52rem, calc(100% - 2rem));
    height: min(22rem, calc(100% - 2rem));
    border: 1px solid rgb(210 230 255 / 0.28);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(180 210 255 / 0.05), transparent 68%);
    opacity: 0.40;
    translate: -50% calc(-50% + var(--signal-parallax, 0px) * 0.1);
    animation: signalContourFlow 22s ease-in-out infinite alternate;
  }

  .signal-stage::after {
    width: min(38rem, calc(100% - 4rem));
    height: min(16rem, calc(100% - 4rem));
    border-color: rgb(122 201 185 / 0.56);
    background: radial-gradient(ellipse at center, rgb(122 201 185 / 0.06), transparent 68%);
    opacity: 0.52;
    animation-name: signalContourFlowAlt;
    animation-duration: 28s;
    animation-direction: alternate;
  }

  .signal-thread,
  .signal-ring,
  .signal-core {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .signal-thread {
    --signal-thread-angle: 0deg;
    --signal-thread-offset: 0rem;
    left: 12%;
    right: 12%;
    top: calc(50% + var(--signal-thread-offset));
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(122 201 185 / 0.84), rgb(253 213 127 / 0.84), transparent);
    transform-origin: 50% 50%;
    transform: rotate(var(--signal-thread-angle));
    animation: threadPulse 7s ease-in-out infinite;
    translate: 0 calc(var(--signal-parallax, 0px) * 0.2);
  }

  .thread-one {
    --signal-thread-angle: 11deg;
    --signal-thread-offset: calc(-1 * var(--signal-thread-gap));
  }

  .thread-two {
    --signal-thread-angle: -17deg;
    animation-duration: 8.5s;
  }

  .thread-three {
    --signal-thread-angle: 4deg;
    --signal-thread-offset: var(--signal-thread-gap);
    animation-duration: 10.25s;
  }

  .signal-ring {
    inset: 50% auto auto 50%;
    width: clamp(8rem, 22vw, 18rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: 50%;
    translate: -50% calc(-50% + var(--signal-parallax, 0px) * 0.15);
    animation: ringBreathe 9s ease-in-out infinite;
  }

  .ring-two {
    width: clamp(12rem, 30vw, 24rem);
    border-color: rgb(122 201 185 / 0.38);
    animation-duration: 11.5s;
  }

  .ring-three {
    width: clamp(16rem, 38vw, 31rem);
    border-color: rgb(253 213 127 / 0.28);
    animation-duration: 14s;
  }

  .signal-core {
    top: 50%;
    left: 50%;
    width: clamp(4.5rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.60);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.90) 0 2px, transparent 3px),
      conic-gradient(from 0deg, rgb(122 201 185 / 0.14), rgb(253 213 127 / 0.38), rgb(255 255 255 / 0.14), rgb(122 201 185 / 0.14));
    box-shadow:
      0 0 52px rgb(122 201 185 / 0.38),
      0 0 18px rgb(253 213 127 / 0.14),
      inset 0 0 28px rgb(255 255 255 / 0.18);
    translate: -50% calc(-50% + var(--signal-parallax, 0px) * 0.05);
    animation: coreTurn 10s linear infinite;
  }

  .signal-core::before,
  .signal-core::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid rgb(255 255 255 / 0.44);
    transform: rotate(45deg);
  }

  .signal-core::after {
    inset: 36%;
    border-radius: 50%;
    transform: none;
  }

  /* Tiled CSS starfield: two overlapping layers with different tile sizes,
     independent twinkling rhythms, and independent parallax rates for depth.
     Each layer extends above the stage so scroll parallax never exposes a
     gap at the top edge. */
  .signal-starfield {
    position: absolute;
    inset: -65px 0 0 0;
    pointer-events: none;
    /* Dense small stars — 8 per 175×175 px tile */
    background:
      radial-gradient(1.2px 1.2px at 22px 14px, rgb(255 255 255 / 0.80), transparent),
      radial-gradient(1px   1px   at 58px 88px, rgb(255 255 255 / 0.56), transparent),
      radial-gradient(1.5px 1.5px at 102px 32px, rgb(255 255 255 / 0.70), transparent),
      radial-gradient(1px   1px   at 140px 120px, rgb(122 201 185 / 0.68), transparent),
      radial-gradient(1.2px 1.2px at 8px  150px, rgb(255 255 255 / 0.48), transparent),
      radial-gradient(1px   1px   at 165px 65px, rgb(253 213 127 / 0.60), transparent),
      radial-gradient(1px   1px   at 80px 168px, rgb(255 255 255 / 0.42), transparent),
      radial-gradient(1.5px 1.5px at 128px 8px,  rgb(255 255 255 / 0.64), transparent);
    background-size: 175px 175px;
    opacity: 0.54;
    animation: starTwinkle 7s ease-in-out infinite alternate;
    translate: 0 calc(var(--signal-parallax, 0px) * 0.5);
  }

  /* Sparser bright stars — 5 per 340×240 px tile */
  .signal-starfield-near {
    position: absolute;
    inset: -40px 0 0 0;
    pointer-events: none;
    background:
      radial-gradient(2px   2px   at 60px  40px,  rgb(255 255 255 / 0.92), transparent),
      radial-gradient(2.5px 2.5px at 185px 130px, rgb(122 201 185 / 0.82), transparent),
      radial-gradient(2px   2px   at 285px 62px,  rgb(255 255 255 / 0.86), transparent),
      radial-gradient(1.5px 1.5px at 105px 195px, rgb(253 213 127 / 0.72), transparent),
      radial-gradient(2px   2px   at 315px 195px, rgb(255 255 255 / 0.78), transparent);
    background-size: 340px 240px;
    opacity: 0.36;
    animation: starTwinkle 11s ease-in-out infinite alternate-reverse;
    translate: 0 calc(var(--signal-parallax, 0px) * 0.3);
  }

  @keyframes starTwinkle {
    0%   { opacity: 0.42; }
    38%  { opacity: 0.62; }
    72%  { opacity: 0.46; }
    100% { opacity: 0.58; }
  }

  @keyframes signalContourFlow {
    0% {
      opacity: 0.40;
      transform: rotate(0deg) scale(1);
    }

    100% {
      opacity: 0.52;
      transform: rotate(4deg) scale(1.03);
    }
  }

  @keyframes signalContourFlowAlt {
    0% {
      opacity: 0.52;
      transform: rotate(0deg) scale(1);
    }

    100% {
      opacity: 0.40;
      transform: rotate(-4deg) scale(0.98);
    }
  }

  @keyframes threadPulse {
    0%,
    100% {
      opacity: 0.50;
      scale: 1 1;
    }

    50% {
      opacity: 0.96;
      scale: 1.04 1;
    }
  }

  @keyframes ringBreathe {
    0%,
    100% {
      opacity: 0.56;
      scale: 1;
    }

    50% {
      opacity: 0.78;
      scale: 1.04;
    }
  }

  @keyframes coreTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-stage::before,
    .signal-stage::after,
    .signal-thread,
    .signal-ring,
    .signal-core,
    .signal-starfield,
    .signal-starfield-near {
      animation: none;
    }
  }

  .engagement-panel {
    width: min(100%, 62rem);
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    padding-block-start: clamp(1rem, 3vw, 1.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    text-align: left;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .engagement-grid article {
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .engagement-grid strong {
    color: rgb(250 250 250 / 0.9);
    font-weight: 650;
    -webkit-text-fill-color: currentColor;
  }

  .engagement-grid p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .latest-publications {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 18% 18%, rgb(122 201 185 / 0.26), transparent 42%),
      radial-gradient(ellipse at 88% 84%, rgb(253 213 127 / 0.18), transparent 38%),
      linear-gradient(180deg, rgb(6 7 10 / 0.58), rgb(6 7 10 / 0.76)),
      url('/assets/analog-article-collage.svg') center / cover no-repeat;
    box-shadow:
      0 18px 54px rgb(0 0 0 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    text-align: center;
  }

  .latest-publications h2 {
    margin: 0.35rem auto 0;
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    line-height: 1.05;
    text-align: center;
  }

  .articles-kicker,
  .articles-summary {
    margin: 0;
    text-align: center;
  }

  .articles-kicker {
    color: rgb(253 213 127 / 0.86);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .articles-summary {
    max-width: 34rem;
    margin: 0.7rem auto 1rem;
    color: rgb(250 250 250 / 0.76);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .articles-heading-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    -webkit-text-fill-color: inherit;
  }

  .articles-heading-link:hover,
  .articles-heading-link:focus-visible {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .latest-publications :global(.card-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    text-align: center;
  }

  .latest-publications :global(.sl-link-card) {
    min-height: 100%;
    border-color: rgb(255 255 255 / 0.16);
    background: rgb(9 9 11 / 0.72);
    text-align: center;
  }

  .latest-publications :global(.sl-link-card .stack) {
    align-items: center;
  }

  .latest-publications :global(.sl-link-card .description) {
    overflow-wrap: anywhere;
  }

  .articles-actions {
    display: flex;
    justify-content: center;
    margin-block-start: 1rem;
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contact-strip .eyebrow {
    max-width: 36rem;
  }

  .contact-strip {
    width: min(100%, 46rem);
    margin-inline: auto;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 46rem) {
    .contact-strip {
      margin-block-end: 4rem;
    }

    .intro-copy,
    .latest-publications {
      width: 100%;
    }

    .home-opening {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }

    .home-hero-copy h1 {
      font-size: 2.35rem;
    }

    .home-opening .signal-stage {
      height: clamp(16rem, 50vh, 24rem);
    }

    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .engagement-grid article {
      min-height: auto;
    }

    .latest-publications {
      padding: 0.875rem;
    }

    .articles-kicker {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }

    .articles-summary {
      max-width: 18rem;
      font-size: 0.76rem;
      line-height: 1.35;
    }

    .latest-publications :global(.card-grid) {
      grid-template-columns: 1fr;
    }

    .contact-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 0.35rem;
    }

    .contact-line {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (min-width: 50rem) {
    :global(html[data-has-sidebar]) {
      --sl-content-inline-start: 0rem;
    }

    :global(html[data-has-sidebar] .sidebar-pane) {
      display: none;
    }
  }

  @media (min-width: 72rem) {
    .latest-publications :global(.card-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

</style>
