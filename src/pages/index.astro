---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { articleNavItems } from '../article-nav.mjs';

const frontmatter = {
  title: 'Home',
  description:
    'Guanchen - technology consulting for resilient systems across cloud, APIs, integration, observability, and operations.',
  template: 'splash',
  giscus: false,
  prev: false,
  next: false,
} as const;

const articleLinks = articleNavItems.map(({ label, link }) => ({ href: link, title: label }));
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true} lang="en">
  <section class="home-intro">
    <h2>Adaptive systems consulting</h2>
    <p class="intro-copy">
      Guanchen helps organizations build foundations that evolve without losing integrity. Architecture
      is not more machinery; it is clearer agreement between people, software, and uncertainty.
    </p>

    <section class="signal-oracle" aria-labelledby="signal-heading">
      <div class="signal-stage" aria-hidden="true">
        <span class="signal-rune rune-one"></span>
        <span class="signal-rune rune-two"></span>
        <span class="signal-rune rune-three"></span>
        <span class="signal-thread thread-one"></span>
        <span class="signal-thread thread-two"></span>
        <span class="signal-thread thread-three"></span>
        <span class="signal-ring ring-one"></span>
        <span class="signal-ring ring-two"></span>
        <span class="signal-ring ring-three"></span>
        <span class="signal-core"></span>
      </div>
      <div class="signal-copy">
        <p class="eyebrow">Systems work for uncertain terrain</p>
        <h2 id="signal-heading">A moving map for the hidden forces in your platform</h2>
        <p>
          APIs, queues, cloud foundations, observability, and operations all leave traces. Guanchen turns
          those traces into decisions teams can trust, then helps make the next change smaller.
        </p>
      </div>
    </section>

    <section class="engagement-panel" aria-labelledby="engagement-heading">
      <p class="eyebrow">Engagements are intentionally practical</p>
      <h2 id="engagement-heading">From uneasy signals to reliable movement</h2>
      <div class="engagement-grid">
        <article>
          <h3>Clarify the shape</h3>
          <p>Map the current pressure across teams, interfaces, runtime behavior, and delivery flow.</p>
        </article>
        <article>
          <h3>Reduce the drag</h3>
          <p>Turn noisy architecture debates into a smaller set of standards, tradeoffs, and next steps.</p>
        </article>
        <article>
          <h3>Strengthen the system</h3>
          <p>Design foundations that hold up when ownership, traffic, dependencies, and incidents change.</p>
        </article>
      </div>
    </section>

    <figure class="page-art">
      <img class="article-art-image" src="/assets/analog-article-collage.svg" alt="Dark analog collage with columns and notebook pages" width="1200" height="520" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption class="articles-overlay" aria-labelledby="articles-heading">
        <h2 id="articles-heading">Publications</h2>
        <div class="article-links">
          {articleLinks.map((article) => <a class="article-link" href={article.href}>{article.title}</a>)}
        </div>
      </figcaption>
    </figure>

  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">
      Guanchen is a sole proprietorship by Erwin Kramer; the name is pronounced <em>"GWAN-chay"</em> and nods to the Guanches, pre-Hispanic island people of the Canaries.
    </p>
    <div class="contact-grid">
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">💼</span>
        <a href="https://www.linkedin.com/in/kramererwin/" target="_blank" rel="noreferrer">linkedin/kramererwin</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href="https://github.com/erwinkramer#-hi-there" target="_blank" rel="noreferrer">github/erwinkramer</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href="mailto:info@guanchen.nl">info@guanchen.nl</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href="https://www.kvk.nl/bestellen/#/88833801000054661021/" target="_blank" rel="noreferrer">KvK 88833801</a>
      </span>
      <span class="contact-line">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>VAT NL003007917B65</span>
      </span>
    </div>
  </section>
</StarlightPage>

<style>
  :global(html[data-has-sidebar]) {
    --sl-content-width: 74rem;
    --home-panel-width: 74rem;
  }

  .home-intro {
    width: min(100%, var(--home-panel-width));
    margin-inline: auto;
    text-align: center;
  }

  .home-intro :is(h2, h3) {
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 46rem;
    margin-inline: auto;
  }

  .signal-oracle {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(17rem, 0.82fr);
    gap: clamp(1.25rem, 4vw, 3.75rem);
    align-items: center;
    width: 100%;
    margin: clamp(1.75rem, 5vw, 3.5rem) auto 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 18% 22%, rgb(122 201 185 / 0.22), transparent 42%),
      radial-gradient(ellipse at 84% 16%, rgb(253 213 127 / 0.18), transparent 34%),
      linear-gradient(135deg, rgb(19 23 25 / 0.92), rgb(7 8 10 / 0.9) 58%, rgb(17 18 15 / 0.9));
    box-shadow:
      0 26px 70px rgb(0 0 0 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  .signal-oracle::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(0deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 3.75rem 3.75rem;
    mask-image: radial-gradient(ellipse at 36% 52%, black 18%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse at 36% 52%, black 18%, transparent 72%);
    pointer-events: none;
  }

  .signal-oracle::after {
    content: '';
    position: absolute;
    inset: -35% -10%;
    background: conic-gradient(from 90deg, transparent, rgb(255 255 255 / 0.12), transparent 24%, transparent 100%);
    opacity: 0.48;
    animation: signalSweep 12s linear infinite;
    pointer-events: none;
  }

  .signal-stage,
  .signal-copy {
    position: relative;
    z-index: 1;
  }

  .signal-stage {
    min-height: clamp(18rem, 40vw, 30rem);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.45rem;
    background:
      radial-gradient(circle at center, rgb(255 255 255 / 0.08), transparent 28%),
      repeating-radial-gradient(circle at center, transparent 0 2.35rem, rgb(255 255 255 / 0.055) 2.4rem 2.45rem),
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 42%);
    box-shadow: inset 0 0 48px rgb(0 0 0 / 0.45);
  }

  .signal-stage::before,
  .signal-stage::after {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(255 255 255 / 0.22);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    opacity: 0.42;
    animation: signalTurn 18s linear infinite;
  }

  .signal-stage::after {
    inset: 20%;
    border-color: rgb(122 201 185 / 0.48);
    opacity: 0.54;
    animation-duration: 24s;
    animation-direction: reverse;
  }

  .signal-rune,
  .signal-thread,
  .signal-ring,
  .signal-core {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .signal-rune {
    width: clamp(3rem, 7vw, 5.6rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.26);
    transform: rotate(45deg);
    animation: runeDrift 8s ease-in-out infinite alternate;
  }

  .signal-rune::before,
  .signal-rune::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid currentColor;
    color: rgb(255 255 255 / 0.26);
  }

  .signal-rune::after {
    inset: 42% -28%;
    border-inline: 0;
  }

  .rune-one {
    top: 14%;
    left: 16%;
    color: rgb(122 201 185 / 0.78);
  }

  .rune-two {
    right: 14%;
    bottom: 18%;
    color: rgb(253 213 127 / 0.68);
    animation-delay: -2s;
  }

  .rune-three {
    top: 53%;
    left: 44%;
    width: clamp(2rem, 5vw, 4rem);
    color: rgb(231 238 224 / 0.55);
    animation-delay: -4s;
  }

  .signal-thread {
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(122 201 185 / 0.72), rgb(253 213 127 / 0.72), transparent);
    transform-origin: 50% 50%;
    animation: threadPulse 7s ease-in-out infinite;
  }

  .thread-one {
    top: 33%;
    transform: rotate(11deg);
  }

  .thread-two {
    top: 58%;
    transform: rotate(-17deg);
    animation-delay: -2.4s;
  }

  .thread-three {
    top: 74%;
    transform: rotate(4deg);
    animation-delay: -4.6s;
  }

  .signal-ring {
    inset: 50% auto auto 50%;
    width: clamp(8rem, 22vw, 18rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 50%;
    translate: -50% -50%;
    animation: ringBreathe 9s ease-in-out infinite;
  }

  .ring-two {
    width: clamp(12rem, 30vw, 24rem);
    border-style: dashed;
    border-color: rgb(122 201 185 / 0.34);
    animation-delay: -3s;
  }

  .ring-three {
    width: clamp(16rem, 38vw, 31rem);
    border-color: rgb(253 213 127 / 0.22);
    animation-delay: -6s;
  }

  .signal-core {
    top: 50%;
    left: 50%;
    width: clamp(4.5rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.72) 0 2px, transparent 3px),
      conic-gradient(from 0deg, rgb(122 201 185 / 0.08), rgb(253 213 127 / 0.28), rgb(255 255 255 / 0.08), rgb(122 201 185 / 0.08));
    box-shadow:
      0 0 38px rgb(122 201 185 / 0.28),
      inset 0 0 24px rgb(255 255 255 / 0.12);
    translate: -50% -50%;
    animation: coreTurn 10s linear infinite;
  }

  .signal-core::before,
  .signal-core::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px solid rgb(255 255 255 / 0.34);
    transform: rotate(45deg);
  }

  .signal-core::after {
    inset: 36%;
    border-radius: 50%;
    transform: none;
  }

  .signal-copy {
    max-width: 23rem;
    text-align: left;
  }

  .signal-copy .eyebrow {
    margin-block-end: 0.65rem;
    color: rgb(253 213 127 / 0.78);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .signal-copy h2 {
    margin-block: 0 0.85rem;
    font-size: clamp(1.55rem, 3.2vw, 2.9rem);
    line-height: 1.08;
  }

  .signal-copy p:last-child {
    margin-block: 0;
    color: rgb(250 250 250 / 0.78);
    font-size: var(--sl-text-base);
  }

  .engagement-panel {
    width: 100%;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    text-align: left;
  }

  .engagement-panel > .eyebrow {
    margin-block-end: 0.35rem;
    color: var(--sl-color-gray-2);
    text-align: center;
  }

  .engagement-panel > h2 {
    max-width: 39rem;
    margin: 0 auto 1rem;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    text-align: center;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .engagement-grid article {
    min-height: 10.5rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 0.5rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.025));
  }

  .engagement-grid h3 {
    margin-block: 0 0.45rem;
    font-size: var(--sl-text-lg);
  }

  .engagement-grid p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  @keyframes signalSweep {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes signalTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes runeDrift {
    from {
      translate: -0.35rem 0.25rem;
    }

    to {
      translate: 0.35rem -0.25rem;
    }
  }

  @keyframes threadPulse {
    0%,
    100% {
      opacity: 0.22;
      scale: 0.86 1;
    }

    50% {
      opacity: 0.88;
      scale: 1 1;
    }
  }

  @keyframes ringBreathe {
    0%,
    100% {
      opacity: 0.28;
      scale: 0.96;
    }

    50% {
      opacity: 0.68;
      scale: 1.04;
    }
  }

  @keyframes coreTurn {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-oracle::after,
    .signal-stage::before,
    .signal-stage::after,
    .signal-rune,
    .signal-thread,
    .signal-ring,
    .signal-core {
      animation: none;
    }
  }

  .page-art {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0.5rem;
    background:
      radial-gradient(ellipse at 16% 16%, rgb(122 201 185 / 0.22), transparent 38%),
      rgb(255 255 255 / 0.03);
    box-shadow:
      0 24px 70px rgb(0 0 0 / 0.42),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  .page-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(122 201 185 / 0.12), transparent 34%),
      radial-gradient(ellipse at 88% 84%, rgb(253 213 127 / 0.14), transparent 36%);
    opacity: 0.86;
    pointer-events: none;
  }

  .page-art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(6 7 10 / 0.88) 0%, rgb(6 7 10 / 0.62) 44%, rgb(6 7 10 / 0.18) 100%),
      linear-gradient(180deg, rgb(6 6 9 / 0.04) 30%, rgb(6 7 10 / 0.82) 100%);
    pointer-events: none;
  }

  .home-intro .page-art .article-art-image {
    display: block;
    width: 100%;
    aspect-ratio: 30 / 13;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    opacity: 0.8;
    filter: saturate(0.95) contrast(1.04) brightness(0.88);
  }

  .articles-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(1rem, 2.8vw, 1.75rem);
    align-items: end;
    padding: clamp(1rem, 3vw, 1.6rem);
    text-align: left;
  }

  .articles-overlay h2 {
    position: absolute;
    inset-block-start: clamp(1rem, 3vw, 1.6rem);
    inset-inline-start: clamp(1rem, 3vw, 1.6rem);
    margin: 0;
    padding-block-start: 0.75rem;
    max-width: calc(100% - clamp(2rem, 6vw, 3.2rem));
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    line-height: 1;
    text-shadow: 0 10px 28px rgb(0 0 0 / 0.46);
  }

  .articles-overlay h2::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: clamp(5.5rem, 13vw, 8.5rem);
    height: 3px;
    background: linear-gradient(90deg, rgb(253 213 127 / 0.95), rgb(122 201 185 / 0.72));
    box-shadow: 0 0 16px rgb(253 213 127 / 0.4);
  }

  .article-links {
    display: grid;
    grid-column: 2;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .articles-overlay a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
    min-height: 3rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 0.5rem;
    background: linear-gradient(135deg, rgb(34 36 40 / 0.88), rgb(8 9 12 / 0.78));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      0 10px 24px rgb(0 0 0 / 0.2);
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .articles-overlay a::before {
    content: '';
    flex: 0 0 auto;
    width: 0.42rem;
    aspect-ratio: 1;
    margin-inline-end: 0.5rem;
    border-radius: 50%;
    background: rgb(253 213 127 / 0.9);
    box-shadow: 0 0 14px rgb(253 213 127 / 0.45);
  }

  .articles-overlay a:hover {
    border-color: rgb(253 213 127 / 0.62);
    background: linear-gradient(135deg, rgb(42 44 48 / 0.92), rgb(8 9 12 / 0.84));
    color: var(--sl-color-white);
    transform: translateY(-1px);
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contact-strip .eyebrow {
    max-width: 36rem;
  }

  .contact-strip {
    width: min(100%, 46rem);
    margin-inline: auto;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 46rem) {
    .contact-strip {
      margin-block-end: 4rem;
    }

    .intro-copy,
    .page-art {
      width: 100%;
    }

    .signal-oracle {
      grid-template-columns: 1fr;
      gap: 1rem;
      width: 100%;
      margin-inline: 0;
      padding: 0.75rem;
      transform: none;
    }

    .signal-stage {
      min-height: clamp(16rem, 78vw, 24rem);
    }

    .signal-copy {
      max-width: none;
      padding: 0.25rem 0.25rem 0.35rem;
      text-align: center;
    }

    .signal-copy h2 {
      font-size: clamp(1.45rem, 8vw, 2.15rem);
    }

    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .engagement-grid article {
      min-height: auto;
    }

    .articles-overlay {
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.9rem;
      padding: 0.75rem;
      text-align: left;
    }

    .articles-overlay h2 {
      position: relative;
      inset: auto;
      align-self: flex-start;
      padding: 0.75rem 0 0;
      margin: 0 0 0.75rem;
      max-width: 100%;
      font-size: clamp(1.45rem, 7vw, 2rem);
      line-height: 1.1;
      text-align: left;
    }

    .articles-overlay h2::before {
      inset-inline: 0 auto;
      width: clamp(6rem, 34vw, 9rem);
      height: 4px;
      box-shadow: 0 0 16px rgb(253 213 127 / 0.46);
    }

    .home-intro .page-art .article-art-image {
      aspect-ratio: 16 / 9;
      height: clamp(19rem, 78vw, 31rem);
    }

    .article-links {
      display: grid;
      grid-column: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.3rem;
    }

    .articles-overlay a {
      width: 100%;
      min-width: 0;
      min-height: 2.25rem;
      padding: 0.25rem 0.45rem;
      overflow-wrap: anywhere;
      font-size: var(--sl-text-sm);
      line-height: 1.15;
      white-space: normal;
    }

    .contact-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 0.35rem;
    }

    .contact-line {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (min-width: 40rem) and (max-width: 46rem) {
    .home-intro .page-art .article-art-image {
      aspect-ratio: 4 / 3;
    }

    .article-links {
      align-self: flex-start;
      grid-template-columns: 1fr;
      justify-content: start;
      gap: 0.4rem;
      width: min(68vw, 24rem);
      margin-inline: 0 auto;
    }

    .articles-overlay a {
      min-height: 2.35rem;
      padding-block: 0.35rem;
    }
  }

  @media (min-width: 50rem) {
    :global(html[data-has-sidebar]) {
      --sl-content-inline-start: 0rem;
    }

    :global(html[data-has-sidebar] .sidebar-pane) {
      display: none;
