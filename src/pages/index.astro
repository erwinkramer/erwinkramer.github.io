---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { articleNavItems } from '../article-nav.mjs';

const frontmatter = {
  title: 'Home',
  description:
    'Guanchen - technology consulting for resilient systems across cloud, APIs, integration, observability, and operations.',
  template: 'splash',
  giscus: false,
  prev: false,
  next: false,
} as const;

const articleLinks = articleNavItems.map(({ label, link }) => ({ href: link, title: label }));
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true} lang="en">
  <section class="home-intro">
    <h2>Technology consulting for resilient systems</h2>
    <p class="intro-copy">
      Guanchen helps organizations design secure, adaptable technology foundations across cloud, APIs,
      integration, observability, and operations.
    </p>

    <figure class="page-art">
      <img class="article-art-image" src="/assets/analog-article-collage.svg" alt="Dark analog collage with columns and notebook pages" width="1200" height="520" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption class="articles-overlay" aria-labelledby="articles-heading">
        <h2 id="articles-heading">Articles</h2>
        <div class="article-links">
          {articleLinks.map((article) => <a class="article-link" href={article.href}>{article.title}</a>)}
        </div>
      </figcaption>
    </figure>

  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">
      Guanchen is a sole proprietorship by Erwin Kramer; the name is pronounced <em>"GWAN-chay"</em> and nods to the Guanches, pre-Hispanic island people of the Canaries.
    </p>
    <div class="contact-grid">
      <span class="contact-line contact-linkedin">
        <span class="contact-icon" aria-hidden="true">🕴️</span>
        <a href="https://www.linkedin.com/in/kramererwin/" target="_blank" rel="noreferrer">linkedin/kramererwin</a>
      </span>
      <span class="contact-line contact-github">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href="https://github.com/erwinkramer#-hi-there" target="_blank" rel="noreferrer">github/erwinkramer</a>
      </span>
      <span class="contact-line contact-email">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href="mailto:info@guanchen.nl">info@guanchen.nl</a>
      </span>
      <span class="contact-line contact-kvk">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href="https://www.kvk.nl/bestellen/#/88833801000054661021/" target="_blank" rel="noreferrer">KvK 88833801</a>
      </span>
      <span class="contact-line contact-vat">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>VAT NL003007917B65</span>
      </span>
    </div>
  </section>
</StarlightPage>

<style>
  :global(html[data-has-sidebar]) {
    --sl-content-width: 67.5rem;
  }

  .home-intro {
    width: 100%;
  }

  .home-intro :is(h2, h3) {
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 46rem;
  }

  .page-art {
    position: relative;
    overflow: hidden;
    width: min(100%, 46rem);
    max-width: 100%;
    margin: 1.5rem 0 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.03);
  }

  .page-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 6 9 / 0.04) 34%, rgb(6 7 10 / 0.68) 100%);
    pointer-events: none;
  }

  .home-intro .page-art .article-art-image {
    display: block;
    width: 100%;
    aspect-ratio: 30 / 13;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    opacity: 0.86;
    filter: saturate(0.92) contrast(0.96) brightness(0.92);
  }

  .articles-overlay {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 1rem;
  }

  .articles-overlay h2 {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-lg);
  }

  .article-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .articles-overlay a {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 0.5rem;
    background: rgb(8 9 12 / 0.34);
    color: var(--sl-color-white);
    backdrop-filter: blur(8px);
    font-weight: 600;
    text-decoration: none;
  }

  .articles-overlay a:hover {
    border-color: rgb(255 255 255 / 0.46);
    background: rgb(255 255 255 / 0.12);
    color: var(--sl-color-white);
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contact-strip .eyebrow {
    max-width: 36rem;
  }

  .contact-strip {
    width: 100%;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-linkedin {
    grid-column: 1;
    grid-row: 1;
  }

  .contact-github {
    grid-column: 1;
    grid-row: 2;
  }

  .contact-email {
    grid-column: 1;
    grid-row: 3;
  }

  .contact-kvk {
    grid-column: 2;
    grid-row: 1;
  }

  .contact-vat {
    grid-column: 2;
    grid-row: 2;
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 44rem) {
    .intro-copy,
    .page-art {
      width: 100%;
    }

    .articles-overlay {
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 0.75rem;
    }

    .articles-overlay h2 {
      margin-block-end: 0.5rem;
      font-size: var(--sl-text-base);
    }

    .home-intro .page-art .article-art-image {
      aspect-ratio: 16 / 9;
    }

    .article-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.3rem;
    }

    .articles-overlay a {
      width: 100%;
      min-width: 0;
      min-height: 2.25rem;
      padding: 0.25rem 0.45rem;
      overflow-wrap: anywhere;
      font-size: var(--sl-text-sm);
      line-height: 1.15;
      white-space: normal;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 0.35rem;
    }

    .contact-line {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (min-width: 50rem) {
    :global(html[data-has-sidebar]) {
      --sl-content-inline-start: 0rem;
    }

    :global(html[data-has-sidebar] .sidebar-pane) {
      display: none;
    }
  }

  @media (max-width: 28rem) {
    .home-intro .page-art .article-art-image {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 24rem) {
    .home-intro .page-art .article-art-image {
      aspect-ratio: 1 / 1;
    }
  }

</style>