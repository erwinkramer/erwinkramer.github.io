---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const frontmatter = {
  title: 'Home',
  description: 'Guanchen - cloud consulting and IT services.',
  template: 'splash',
  giscus: false,
} as const;

const blogPosts = (await getCollection('docs'))
  .filter((entry) => entry.id.startsWith('blog/'))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const latestBlogHref = blogPosts[0] ? `/${blogPosts[0].id}/` : '/blog/';
---

<StarlightPage frontmatter={frontmatter} hasSidebar={false} lang="en">
  <section class="home-intro">
    <h2>Practical cloud consulting</h2>
    <p class="intro-copy">
      Guanchen helps design and implement cloud environments that are secure, scalable, and easy to evolve.
    </p>

    <figure class="page-art">
      <img src="/assets/analog-blog-collage.svg" alt="Dark analog collage with columns and notebook pages" />
    </figure>

    <p class="home-actions">
      <a class="primary-link" href={latestBlogHref}>Read the blog</a>
    </p>
  </section>

  <section class="contact-strip" aria-label="Contact and registration details">
    <p class="eyebrow">Cloud consulting and IT services by Erwin Kramer.</p>
    <div class="contact-grid">
      <span class="contact-line contact-linkedin">
        <span class="contact-icon" aria-hidden="true">🕴️</span>
        <a href="https://www.linkedin.com/in/kramererwin/" target="_blank" rel="noreferrer">linkedin/kramererwin</a>
      </span>
      <span class="contact-line contact-github">
        <span class="contact-icon" aria-hidden="true">🚀</span>
        <a href="https://github.com/erwinkramer#-hi-there" target="_blank" rel="noreferrer">github/erwinkramer</a>
      </span>
      <span class="contact-line contact-email">
        <span class="contact-icon" aria-hidden="true">📧</span>
        <a href="mailto:info@guanchen.nl">info@guanchen.nl</a>
      </span>
      <span class="contact-line contact-kvk">
        <span class="contact-icon" aria-hidden="true">🏫</span>
        <a href="https://www.kvk.nl/bestellen/#/88833801000054661021/" target="_blank" rel="noreferrer">KvK 88833801</a>
      </span>
      <span class="contact-line contact-vat">
        <span class="contact-icon" aria-hidden="true">🧾</span>
        <span>VAT NL003007917B65</span>
      </span>
    </div>
  </section>
</StarlightPage>

<style>
  .home-intro {
    width: 100%;
  }

  .home-intro :is(h2, h3) {
    -webkit-text-fill-color: var(--sl-color-white);
    background-image: none;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 46rem;
  }

  .page-art {
    width: min(100%, 46rem);
    max-width: 100%;
  }

  .eyebrow {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .page-art {
    margin: 1.5rem 0 0;
  }

  .page-art img {
    display: block;
    width: 100%;
    aspect-ratio: 30 / 13;
    object-fit: cover;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    opacity: 0.86;
    filter: saturate(0.92) contrast(0.96) brightness(0.92);
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-weight: 600;
    text-decoration: none;
  }

  .primary-link:hover {
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .contact-strip {
    width: 100%;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    opacity: 0.78;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    grid-template-rows: repeat(3, 1.45rem);
    gap: 0 3rem;
    align-items: center;
    font-size: var(--sl-text-xs);
  }

  .contact-linkedin {
    grid-column: 1;
    grid-row: 1;
  }

  .contact-github {
    grid-column: 1;
    grid-row: 2;
  }

  .contact-email {
    grid-column: 1;
    grid-row: 3;
  }

  .contact-kvk {
    grid-column: 2;
    grid-row: 1;
  }

  .contact-vat {
    grid-column: 2;
    grid-row: 2;
  }

  .contact-strip a,
  .contact-line {
    overflow-wrap: anywhere;
  }

  .contact-line {
    display: grid;
    grid-template-columns: 1rem auto;
    gap: 0.35rem;
    align-items: center;
    height: 1.45rem;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  .contact-icon {
    flex: 0 0 auto;
    opacity: 0.5;
    text-align: center;
  }

  .contact-strip a {
    color: var(--sl-color-gray-3);
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.16em;
  }

  .contact-strip a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
    opacity: 1;
  }
  
  @media (max-width: 44rem) {
    .intro-copy,
    .page-art {
      width: 100%;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 0.35rem;
    }

    .contact-line {
      grid-column: auto;
      grid-row: auto;
    }
  }

</style>