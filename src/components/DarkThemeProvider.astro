<meta name="color-scheme" content="dark" />

<script is:inline>
	(() => {
		const root = document.documentElement;
		let isScrolled = false;
		let frame = 0;

		const updateScrolled = () => {
			frame = 0;

			const nextScrolled = window.scrollY > 0;
			if (nextScrolled === isScrolled) return;

			isScrolled = nextScrolled;
			root.toggleAttribute('data-scrolled', isScrolled);
		};

		const requestScrolledUpdate = () => {
			if (frame) return;

			frame = window.requestAnimationFrame(updateScrolled);
		};

		updateScrolled();
		window.addEventListener('scroll', requestScrolledUpdate, { passive: true });
	})();
</script>