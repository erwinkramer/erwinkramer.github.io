---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { siteInfo } from '../site';

const isHomePage = Astro.locals.starlightRoute.id === '';
const date = Astro.locals.starlightRoute.entry.data.date;
const author = Astro.locals.starlightRoute.entry.data.author ?? (date ? siteInfo.author.name : undefined);
const formattedDate = date?.toLocaleDateString('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const wordsPerMinute = 225;
const words = Astro.locals.starlightRoute.entry.body
	?.replace(/```[\s\S]*?```/g, ' ')
	.replace(/<[^>]*>/g, ' ')
	.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
	.replace(/[`*_#>-]/g, ' ')
	.trim()
	.split(/\s+/)
	.filter(Boolean).length;
const readingTime = formattedDate && words ? `🕒 ${Math.max(1, Math.round(words / wordsPerMinute))} min read` : undefined;
const metadata = [author && `By ${author}`, formattedDate, readingTime].filter(Boolean).join(' • ');
---

{
	!isHomePage && (
		<>
			<DefaultPageTitle />
			{metadata && <p class="page-meta">{metadata}</p>}
		</>
	)
}

<style>
	.page-meta {
		margin-block: -0.25rem 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>