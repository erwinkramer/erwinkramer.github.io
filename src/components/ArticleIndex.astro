---
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { articleDateFormatter, getArticles } from '../articles';

const intro = Astro.locals.starlightRoute.entry.data.description;
const articles = await getArticles();
---

{intro && <p class="articles-intro">{intro}</p>}

<section class="article-index" aria-labelledby="all-articles-heading">
  <h2 id="all-articles-heading">All articles</h2>
  <p class="article-index-summary">All Guanchen articles, sorted by date.</p>
  <CardGrid>
    {articles.map((article) => (
      <LinkCard
        href={`/${article.id}/`}
        title={article.data.title}
        description={`<small class="publication-date">Updated ${articleDateFormatter.format(article.data.date)}</small> - ${article.data.description ?? 'Read the Guanchen article.'}`}
      />
    ))}
  </CardGrid>
</section>

<style>
  .articles-intro {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }

  .article-index {
    margin-block-start: 1.75rem;
  }

  .article-index h2 {
    margin-block: 0 0.5rem;
  }

  .article-index-summary {
    margin-block: 0 1rem;
    color: var(--sl-color-gray-2);
  }
</style>